# Enterprise Hybrid RAG & Guardrails Configuration

PROJECT_NAME="Enterprise Hybrid RAG & Guardrails Pipeline"
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Embedding & Reranker Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIMENSION=384

# Vector DB & Storage
CHROMA_PERSIST_DIR=./data/chroma
DEFAULT_COLLECTION_NAME=enterprise_knowledge

# Hybrid Search Parameters
RRF_K=60
DEFAULT_TOP_K=5
HYBRID_ALPHA=0.5

# Guardrails Settings
GUARDRAILS_ENABLED=true
INJECTION_DETECTION_THRESHOLD=0.65
PII_REDACTION_ENABLED=true

# Generation (Local or API)
LLM_PROVIDER=local
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Knowledge Graph
ENABLE_GRAPH_ENRICHMENT=true
