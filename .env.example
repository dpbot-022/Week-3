# SafeStrata Production & Development Configuration Template
# Copy this file to .env: cp .env.example .env

# Environment Mode: 'development' or 'production'
APP_ENV=development

# JWT Authentication (REQUIRED: Application will refuse to start without JWT_SECRET)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars-long
OTP_PEPPER=your-secure-otp-pepper-secret-at-least-32-chars-long

# SMTP Email Configuration (Real OTP Delivery via TLS/SSL)
# Example for Gmail:
# 1. Turn on 2-Step Verification in Google Account
# 2. Generate an App Password (Security -> 2-Step Verification -> App passwords)
# 3. Fill in details below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your.email@gmail.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=10.0

# Server Settings
HOST=0.0.0.0
PORT=8001
DEBUG=false

# Embedding & Reranker Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DIMENSION=384

# Vector DB & Storage
CHROMA_PERSIST_DIR=./data/chroma
DEFAULT_COLLECTION_NAME=enterprise_knowledge

# Hybrid Search Parameters
RRF_K=60
DEFAULT_TOP_K=5
HYBRID_ALPHA=0.5

# Guardrails Settings
GUARDRAILS_ENABLED=true
INJECTION_DETECTION_THRESHOLD=0.65
PII_REDACTION_ENABLED=true

# Generation (Local or Cloud API)
LLM_PROVIDER=local
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
